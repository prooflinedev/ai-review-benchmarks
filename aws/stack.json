{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Proofline AI Review Benchmarks scheduled-report fixture",
  "Parameters": {
    "RuntimeRole": {"Type": "String", "Description": "ARN of the Lambda execution role"}
  },
  "Resources": {
    "ReportLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/${AWS::StackName}"},
        "RetentionInDays": 1
      }
    },
    "ReportFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ReportLogs",
      "Properties": {
        "FunctionName": {"Ref": "AWS::StackName"},
        "Role": {"Ref": "RuntimeRole"},
        "Handler": "index.handler",
        "Runtime": "python3.12",
        "MemorySize": 128,
        "Timeout": 10,
        "Code": {"ZipFile": "Generated by aws/deploy.py package"}
      }
    }
  }
}
